<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Alerts Button</title>
<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0b0b0f;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .alerts-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 222px;
    height: 36px;
    padding: 8px;
    box-sizing: border-box;
    border: 0;
    border-radius: 8px;
    background: linear-gradient(180deg, #715CE5 0%, #614AE2 100%);
    box-shadow: 1.5px 4px 10px 0px rgba(97, 74, 226, 0.25);
    cursor: pointer;
  }

  .alerts-btn .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .alerts-btn .icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: block;
  }

  .alerts-btn .label {
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.42px;
    line-height: 1;
    white-space: nowrap;
  }

  .alerts-btn .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    flex-shrink: 0;
  }

  /* Stroke 1 — FFFFFF, Overlay blend, 30% opacity, Inside, Weight 1 */
  .alerts-btn .stroke-1 {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.3);
    mix-blend-mode: overlay;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }

  /* Stroke 2 — Radial FFFFFF, stops 80%→0%, Plus lighter blend,
     40% layer opacity, Inside, Weight 1.
     Gradient runs diagonally: bright at top-left corner, fading toward bottom-right. */
  .alerts-btn .stroke-2 {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    opacity: 0.4;
    background: radial-gradient(
      120% 120% at 15% 15%,
      rgba(255, 255, 255, 0.8) 0%,
      rgba(255, 255, 255, 0) 100%
    );
    mix-blend-mode: screen;        /* fallback */
    mix-blend-mode: plus-lighter;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }

  /* Stroke 3 — Radial FFFFFF, stops 80%→0%, Plus lighter blend,
     40% layer opacity, Inside, Weight 1.
     Mirror of stroke 2: bright at bottom-right corner, fading toward top-left. */
  .alerts-btn .stroke-3 {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    opacity: 0.4;
    background: radial-gradient(
      120% 120% at 85% 85%,
      rgba(255, 255, 255, 0.8) 0%,
      rgba(255, 255, 255, 0) 100%
    );
    mix-blend-mode: screen;        /* fallback */
    mix-blend-mode: plus-lighter;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }

  /* Inner shadow 1 — X:0 Y:-4 Blur:14 Spread:0, #000000 25%, Overlay blend */
  .alerts-btn .inner-1 {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0px -4px 14px 0px rgba(0, 0, 0, 0.25);
    mix-blend-mode: overlay;
  }

  /* Inner shadow 2 — X:0 Y:4 Blur:14 Spread:0, #FFFFFF 25%, Normal blend */
  .alerts-btn .inner-2 {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0px 4px 14px 0px rgba(255, 255, 255, 0.25);
  }
</style>
</head>
<body>

  <button class="alerts-btn" type="button">
    <span class="stroke-1"></span>
    <span class="stroke-2"></span>
    <span class="stroke-3"></span>
    <span class="left">
      <svg class="icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 8.4A6 6 0 0 0 6 8.4c0 6.3-2.4 8.1-2.4 8.1h16.8S18 14.7 18 8.4Z"
              stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M13.7 20.1a1.95 1.95 0 0 1-3.4 0"
              stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="label">Alerts</span>
    </span>
    <span class="dot"></span>
    <span class="inner-1"></span>
    <span class="inner-2"></span>
  </button>

</body>
</html>
